# Copia este archivo a `.env` y ajusta la IP de tu PC (ipconfig -> IPv4)
# o la URL de ngrok si pruebas con datos móviles.
EXPO_PUBLIC_API_URL=http://192.168.1.100:3000

# Para probar el login: en el servidor usa AURORA_DEMO_CODE=123456 y AURORA_REQUIRE_AUTH=true
# (ver .env.example de aurora-be). El número debe ser un celular chileno: 9 1234 5678.
